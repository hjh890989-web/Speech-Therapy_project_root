{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/actions/**/*.ts": {
      "maxDuration": 60
    },
    "app/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/hitl-monitor",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/audio-cleanup",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/weekly-reports",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/consent-reminder",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/error-monitor",
      "schedule": "*/5 * * * *"
    }
  ]
}
