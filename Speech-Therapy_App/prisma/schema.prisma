// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// DB-002 — User (모든 사용자 관련 FK 의 부모)
// Refs: SRS §2 Stakeholders, §6.1 ERD users, REQ-NF-019 RBAC.
// 개인정보 최소화 원칙 (R4): 자녀 식별정보 미저장, 월령만.
// ============================================================================

enum Role {
  parent
  teacher
  principal
  expert
  admin
}

enum SubscriptionTier {
  free
  basic
  premium
}

model User {
  /// UUID — Supabase Auth user.id 와 동일 키 (API-010).
  id               String           @id @default(uuid())
  /// 인증용 이메일 (Supabase Auth 일치). 무로그인 진단 사용자는 null.
  email            String?          @unique
  /// RBAC 역할. REQ-NF-019 의 키.
  role             Role
  /// 부모의 자녀 월령. 발음(만 2~7세)+문해력(만 2~12세, CR-2026-009) = 24~144. 부모 외 역할은 null.
  childAgeMonths   Int?
  /// FR-C-PARENT-SETTINGS — 부모가 /settings/child 에서 선택한 관심 음소 목록.
  /// 화이트리스트: ALLOWED_PHONEMES (ㄱ/ㄴ/ㅅ/ㅈ/ㄹ), 0~5개 (빈 배열 허용 = 시스템 자동 선택).
  /// R4: 자녀 식별 정보 0건 — 단순 음소 라벨만. 부모 외 역할은 빈 배열로 운용.
  preferredPhonemes String[]         @default([])
  /// FR-C-PARENT-ONBOARDING (follow-up) — 신규 부모 first-time wizard 완료 시각.
  /// localStorage 마킹과 동기화되는 canonical 서버 상태 — 다중 디바이스에서도
  /// 동일한 wizard 노출 여부 결정에 사용. null = 미완료 / 미실행.
  onboardingCompletedAt DateTime?
  /// FR-C-NOTIFICATION-PREFERENCE — 알림 종류별 opt-in/out 선호.
  /// shape (런타임 Zod 검증, lib/notifications/preference.ts NotificationPreference):
  ///   { weeklyReportEmail, cushionNoteEmail, consentReminderEmail, parentInviteEmail }
  /// default '{}' = 모든 키 누락 = opt-out 기반 (helper 가 DEFAULTS 로 merge — default true).
  /// 트랜잭션성 알림 (계정 변경 / 비밀번호 reset 등) 은 본 컬럼 무관 — 항상 발송.
  notificationPreference Json?     @default("{}")
  /// FR-C-SECURITY (MFA 마무리) — TOTP 활성 시 발급된 backup codes 의 sha256 hash 리스트.
  /// 정책 (lib/security/backup-codes-store.ts):
  ///   - 1회 사용 후 array 에서 제거 (재사용 불가 — DB 레벨로 멱등 보장).
  ///   - 사용자 표시는 enroll verify 직후 평문 1회만 — 그 후 hash 만 DB 보존.
  ///   - "재생성" 시 기존 hash 전부 무효화 + 새 8개 생성.
  /// R4: hash 만 저장 (원본 평문 불가역) — 데이터 유출 시에도 backup code 자체 비공개.
  totpBackupCodes String[] @default([])
  /// SEC-COMP-PIPA — PIPA §22-6 만 14세 미만 부모 대리 동의 일시 (Grill #3A A1).
  /// null = 미동의. 본 컬럼이 null 인 parent 는 자녀 진단 / 발화 데이터 처리 차단.
  /// 본 동의는 자녀의 개인정보 처리 (음성 transcript, 월령, 발달 점수) 의 법정대리인 동의 근거.
  /// /settings/privacy-consent 페이지에서 사용자가 직접 체크 → 일시 기록.
  pipaUnderageConsentAt DateTime?
  /// SEC-COMP-PIPA — PIPA §17 개인정보 국외 이전 동의 일시 (Grill #3A A2).
  /// null = 미동의. 본 컬럼이 null 이면 STT (Google Cloud Speech US) / Gemini API (US/global) 호출 차단.
  /// 대상: Google Cloud Speech (Web Speech API 경유) + Google AI Studio (Gemini) 의 미국 / 글로벌 위치.
  overseasTransferConsentAt DateTime?
  /// F10 — 연구 데이터 활용 동의 Tier (SRS §5.3 / ADR-15). null = 미동의(연구 활용 0).
  /// 값: T1(운영) / T2(UX 통계) / T3(내부 모델개선) / T4-a·T4-b(학술) / T4-c(외부협력·IRB).
  /// HITL 재학습(sync_retraining_data TRIGGER)은 T4-a/b/c 동의 시에만 적재(보수적 게이팅, FR-C-WAUR-SWITCH 별개).
  /// 수집 UI 는 후속(Full) — 본 Lean PR 은 컬럼 + TRIGGER 게이팅만(하드코딩 'T4-c' 오표기 해소).
  f10ResearchConsentTier String?
  /// 구독 등급. 기본 free.
  subscriptionTier SubscriptionTier @default(free)
  /// 가입 시각.
  createdAt        DateTime         @default(now())

  // --- DB-003 추가 컬럼 (B2B) ---
  /// parent 는 nullable, teacher/principal 은 비즈니스 로직 레벨로 필수.
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  /// parent: 자녀가 속한 반 / teacher: 담당 반.
  classId       String?
  class         Class?       @relation(fields: [classId], references: [id])

  // --- 역방향 관계 (FK 자체는 자식 쪽 모델에서 정의) ---
  sessionLogs       SessionLog[]
  evaluationResults EvaluationResult[]
  weeklyReports     WeeklyReport[]
  rewardProgress    RewardProgress?
  /// DB-008b: 보상 발급 이력 (멱등성 + 감사).
  rewardLogs        RewardLog[]
  /// DB-009: 본인이 검토 대상이 된 HITL 큐 (parent role 일반적).
  hitlQueues        HITLQueue[]        @relation("HITLSubject")
  /// DB-009: expert 로 지정되어 검토 담당하는 HITL 큐.
  assignedHITLs     HITLQueue[]        @relation("AssignedExpert")
  /// FR-Q-013 후속 — 본인이 대상인 (자녀) 오프라인 활동 기록.
  offlineEntriesAsSubject OfflineEntry[] @relation("OfflineEntrySubject")
  /// FR-Q-013 후속 — 본인이 입력한 (teacher) 오프라인 활동 기록.
  offlineEntriesAsAuthor  OfflineEntry[] @relation("OfflineEntryAuthor")
  /// CR-2026-009 — 본인(자녀) 문해력 놀이/probe 결과.
  literacyResults   LiteracyResult[]

  @@index([institutionId])
  @@index([classId])
}

// ============================================================================
// DB-003 — Institution / Class (B2B 다중 테넌트)
// Refs: §6.1 ERD institutions, REQ-FUNC-046/047, REQ-NF-019.
// ============================================================================

model Institution {
  id                    String    @id @default(uuid())
  name                  String
  principalName         String
  principalEmail        String?   @unique
  phone                 String?
  address               String?
  /// F10 동의서 완료 여부.
  consentStatus         Boolean   @default(false)
  /// Supabase Storage path (DB-002 추가 후 Storage 연동 시 사용).
  logoUri               String?
  subscriptionStartedAt DateTime?
  /// "trial" | "annual_500k" | "annual_1m" — 진입 SKU.
  subscriptionTier      String    @default("trial")
  createdAt             DateTime  @default(now())

  // 역방향
  classes Class[]
  users   User[]
}

model Class {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  /// 담임 교사 (User.role = teacher).
  teacherId     String?
  createdAt     DateTime    @default(now())

  users User[]

  @@index([institutionId])
}

// ============================================================================
// DB-004 — SessionLog (발화 세션 메타데이터)
// Refs: §6.1 ERD session_logs, REQ-FUNC-005, C-TEC-003.
// D6 단순화: audioVectorUri 는 컬럼만 확보 (Sprint 1엔 항상 null), pgvector
// 활성화는 P2 별도 마이그레이션.
// ============================================================================

model SessionLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 진단 세션은 null. 미션 세션이면 MissionCard.id.
  missionId     String?
  mission       MissionCard? @relation(fields: [missionId], references: [id])
  startTime     DateTime @default(now())
  durationSec   Int
  /// TODO: P2 pgvector 활성화 시 vector(768) 타입으로 마이그레이션.
  audioVectorUri String?
  createdAt     DateTime @default(now())

  evaluationResult EvaluationResult?

  @@index([userId, startTime])
}

// ============================================================================
// DB-005 — EvaluationResult (3축 점수 + 백분위 + Confidence)
// Refs: §6.1 ERD evaluation_results, REQ-FUNC-001~003 / 012~013.
// 횡단 CON-04: aiCushionText 는 금칙어 0건 (Server Action 진입 시 검증, FR-C-005).
// ============================================================================

model EvaluationResult {
  id                 String   @id @default(uuid())
  /// SessionLog 1:1.
  sessionId          String   @unique
  sessionLog         SessionLog @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 3축 점수 (0~100 비즈니스 규칙, Zod 검증 책임).
  articulationScore  Float
  linguisticScore    Float
  acousticScore      Float
  /// 또래 백분위 (0~100).
  peerPercentile     Float
  /// 0~100, < 70 시 HITL 이관 (FR-C-002).
  confidence         Float
  /// 전문가 검토 완료 여부.
  hitlReviewed       Boolean  @default(false)
  /// 금칙어 0건 보장 (CON-04). 부모용 쿠션 텍스트.
  aiCushionText      String?
  targetPhoneme      String
  childAgeMonths     Int
  /// CL-04 durable (errorPattern CR) — 결과 페이지가 새로고침/공유(searchParams 유실) 시에도 단어 표시 +
  /// 발달 변동 게이팅(detectVariation)을 DB 에서 재구성하도록 진단 입력 영구 저장. 단일 대상 단어/STT —
  /// 자녀 식별 정보 아님(이미 응답·URL·화면에 노출되던 값). 기존 row 는 null → searchParams 폴백(회귀 0).
  intendedWord       String?
  heardWord          String?
  /// Sprint 3 §2 B — Web Audio API 추출 음향 특징 (pitchMean / pitchStd / durationSec / energy).
  /// 미지원 환경 (jsdom, 권한 거부) 또는 미측정 시 null. 스키마는 lib/audio/analyzer.ts AcousticFeatures.
  acousticFeatures   Json?
  createdAt          DateTime @default(now())

  /// DB-009 역방향: Confidence < 70 시 1:1 매핑된 HITL 큐.
  hitlQueue          HITLQueue?

  @@index([userId, createdAt])
}

// ============================================================================
// DB-006 — MissionCard (음소·난이도별 카탈로그)
// Refs: §6.1 ERD mission_cards, REQ-FUNC-015, 021~022.
// ============================================================================

model MissionCard {
  id              String   @id @default(uuid())
  /// 한국어 음소 (예: "ㅅ").
  targetPhoneme   String
  /// 1~6 (REQ-FUNC-CL-05 임상 위계: 단독음소→음절→단어→구→문장→대화).
  difficultyLevel Int
  /// "star" | "tree" | "drawing".
  rewardType      String
  title           String
  /// 지시문. 금칙어("진단", "장애" 등) 금지.
  instructionText String
  mediaUri        String?
  /// 월령 (만 2~7세 = 24~84).
  ageRangeMin     Int
  ageRangeMax     Int
  createdAt       DateTime @default(now())

  sessionLogs SessionLog[]

  @@index([targetPhoneme, difficultyLevel])
}

// ============================================================================
// DB-007 — WeeklyReport (주간 추이 + 예측)
// Refs: §6.1 ERD weekly_reports, REQ-FUNC-027/028/044, REQ-NF-004.
// scoreTrend Json 스키마: lib/weekly-report.ts 의 ScoreTrend 타입 + Zod.
// ============================================================================

model WeeklyReport {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ISO 8601 주차 (1~53).
  weekNumber           Int
  year                 Int
  /// ScoreTrend[] JSON 배열 (date / phoneme / 3축 / peerPercentile).
  scoreTrend           Json
  /// 회귀 모델 예측 점수.
  predictedNextScore   Float?
  /// 신뢰구간.
  predictionConfidence Float?
  articulationAvg      Float
  linguisticAvg        Float
  acousticAvg          Float
  peerPercentileAvg    Float
  /// 진단(evaluationResult) 세션 수 — 점수 평균/추세의 표본 분모.
  sessionCount         Int
  /// FR-C-WAUR-SWITCH — 미션 완료수(SessionLog missionId!=null & durationSec>0). 북극성 W-AUR 신호.
  /// 기존 row 는 default 0(전환 이전 주는 미집계). wAurAchieved 는 >= W_AUR_MIN_MISSIONS 로 재유도.
  missionCompletedCount Int     @default(0)
  generatedAt          DateTime @default(now())
  /// FR-WEEKLY-UNREAD — 부모가 /weekly-review 페이지를 열어 본 시각.
  /// null = 미열람 (parent nav badge "📅 우리 아이 주간 리뷰" 옆 dot 노출 조건).
  /// 한 번 set 되면 cron 으로 새 row 가 생기기 전까지 유지.
  viewedAt             DateTime?

  @@unique([userId, year, weekNumber])
  @@index([userId, generatedAt])
}

// ============================================================================
// DB-008 — RewardProgress (별·나무·AI그림 누적, userId 1:1)
// Refs: §6.1 ERD reward_progress, REQ-FUNC-024~026, REQ-NF-005.
// ============================================================================

model RewardProgress {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cumulativeStars  Int      @default(0)
  treeGrowthLevel  Int      @default(0)
  aiDrawingCount   Int      @default(0)
  updatedAt        DateTime @updatedAt
}

// ============================================================================
// DB-008b (Sprint 2) — RewardLog (멱등성 보장 + 감사 로그)
// Sprint 1 의 process-local Set 멱등성을 다중 인스턴스 안전한 DB unique 제약으로 교체.
// @@unique([userId, idempotencyKey]) 가 중복 INSERT 를 SQL 레벨에서 차단.
// 향후 reward 발급 이력 조회 / 통계 / 분쟁 처리에도 활용.
// ============================================================================

model RewardLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "star" | "tree" | "drawing".
  rewardType      String
  amount          Int
  /// FR-C-009 멱등성 키 (예: `${sessionId}-star-1`).
  idempotencyKey  String
  createdAt       DateTime @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

// ============================================================================
// DB-009 — HITLQueue (Confidence < 70 자동 이관 대기열)
// Refs: §3.5 hitl/queue, REQ-FUNC-003/032/HITL-001~003, §3.6.2.
// D4 단순화: Supabase Realtime 미사용. 알림은 Slack 웹훅, 운영은 Supabase Studio.
// 횡단 R4: expertComment / groundTruthScore 는 자녀 식별 불가능한 형식 강제.
// ============================================================================

enum HITLStatus {
  pending
  in_review
  completed
  escalated
  dismissed
}

// ============================================================================
// DB-010 — ConsentSignature (FR-C-018 #41) — 동의서 발송 + D+3 리마인더 + 7일 만료
// Refs: SRS §3.5, REQ-FUNC-059~061, REQ-NF-019 (감사 로그).
// 법적 효력: IP / UserAgent / consentText 스냅샷 / 타임스탬프 보존 (서명 후).
// R4 (자녀 보호): 자녀 식별 정보는 별명 (childNickname) 만 보관. 본명/생년월일/주소/연락처 미저장.
// CON-04: 본 model 의 어떤 컬럼도 "치료/진단/장애" 금칙어 미포함 — Server Action 진입 시 검증.
// ============================================================================
//
// 라이프사이클:
//   pending → signed   (부모 서명 완료, signedAt 기록)
//   pending → expired  (sentAt + 7d 경과, expired cron 이 마킹)
//
// D+3 리마인더:
//   pending && sentAt < now - 3d && remindedAt IS NULL → reminder cron 이 발송 후 remindedAt 기록.
//   이미 remindedAt 있는 row 는 skip (멱등).
//
// token:
//   UUID v4 default. parent 가 서명 페이지 진입 시 URL 의 token 으로 단건 조회.
//   token 노출은 본인 only (이메일 inbox) — R4 정책.
//
// 인덱스:
//   - (status, sentAt) — cron 의 D+3 / 7d 스캔 효율.
//   - (parentEmail) — 동일 부모/자녀 중복 발급 시 멱등 조회.
//   - (token) — UNIQUE — 서명 페이지 단건 조회.

model ConsentSignature {
  id            String    @id @default(uuid())
  parentEmail   String
  parentName    String
  childNickname String
  consentType   String    @default("data_usage")
  /// 'pending' | 'signed' | 'expired'.
  status        String    @default("pending")
  token         String    @unique
  sentAt        DateTime  @default(now())
  remindedAt    DateTime?
  signedAt      DateTime?
  expiredAt     DateTime?
  /// 서명 완료 시 저장되는 IP (법적 효력 — 익명 부모도 IP 단서로 분쟁 대응).
  signedIp      String?
  /// 서명 완료 시 저장되는 UserAgent.
  signedUa      String?
  /// 기관 컨텍스트 (B2B). 일반 parent 직접 발급 시 null.
  institutionId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, sentAt])
  @@index([parentEmail])
  @@index([token])
}

model HITLQueue {
  id               String     @id @default(uuid())
  /// EvaluationResult.sessionId 와 1:1.
  sessionId        String     @unique
  evaluationResult EvaluationResult @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  /// 검토 대상 사용자 (parent 일반적).
  userId           String
  user             User       @relation("HITLSubject", fields: [userId], references: [id], onDelete: Cascade)
  confidenceScore  Float
  status           HITLStatus @default(pending)
  /// Supabase Studio 수동 할당 (expert role).
  assignedExpertId String?
  assignedExpert   User?      @relation("AssignedExpert", fields: [assignedExpertId], references: [id])
  expertComment    String?
  /// 보정 3축 점수 {articulation, linguistic, acoustic, peerPercentile}.
  groundTruthScore Json?
  /// FR-C-013 (#36) — 전문가 보정 단일 종합 점수 (0~100, 선택). groundTruthScore (3축) 와 보완 관계.
  correctedScore   Int?
  /// FR-C-013 (#36) — 검토(코멘트 PATCH) 완료 시각. completedAt 과 별도: completedAt 은 큐 라이프사이클 종료 시점.
  reviewedAt       DateTime?
  /// FR-C-013 (#36) — 검토 actor (Supabase auth uid). assignedExpertId 와 다를 수 있음 (admin 대리 검토).
  reviewedBy       String?
  /// 등록 시각 + 48h (REQ-NF-012).
  slaDueAt         DateTime
  /// 24h 초과 시 Cron 이 자동 마킹 (FR-C-014).
  escalatedAt      DateTime?
  /// FR-C-014 잔여 (#37) — 수동/자동 escalation 주체 User.id (자동 cron 시 null).
  escalatedBy      String?
  /// FR-C-014 잔여 (#37) — 'expert_judgment' | 'sla_at_risk' | 'duplicate' | 'manual' | 'auto_cron_24h'.
  escalationReason String?
  completedAt      DateTime?
  createdAt        DateTime   @default(now())

  @@index([status, slaDueAt])
}

// ============================================================================
// FR-Q-013 후속 — OfflineEntry (선생님이 수기 기록하는 자녀 오프라인 활동)
// Refs: §6.1 ERD (확장), REQ-FUNC-058 (B2B 오프라인 활동 통합), REQ-NF-019.
//
// 책임:
//   - 센터/유치원의 선생님이 자녀의 오프라인 발음 연습/관찰/메모를 수기 기록.
//   - 통합 타임라인 (lib/timeline/aggregator.ts loadUserTimeline) 의
//     "offline" kind entry source — 앱 세션(diagnose/mission) 과 merge 노출.
//
// R4 (자녀 보호):
//   - note 본문은 짧은 메모 (max 500자) — 자녀 본명/주소/생년월일/연락처 입력 시
//     입력자(teacher) 책임. 본 PR 은 자동 PII 검출 X — README/UI 안내로 처리.
//   - userId/authorId 는 User UUID 만, 자녀 식별 정보 미저장.
//
// CON-04 (의료 금칙어):
//   - kind 는 'practice' | 'observation' | 'note' enum-like — "치료/진단/장애" 미포함.
//   - note 본문은 Server Action 진입 시 hasBannedTerm 검증 (reject).
//
// 라이프사이클:
//   - INSERT: Server Action /app/actions/offline-entry.ts (teacher/principal/admin)
//   - SELECT: 부모(본인 userId) + teacher/principal/admin/expert (RLS)
//   - UPDATE: author 본인 or admin (수정 기록은 audit_trigger_fn 캡처)
//   - DELETE: admin only
// ============================================================================

model OfflineEntry {
  id            String   @id @default(uuid()) @db.Uuid
  /// 자녀(보호자) User.id — 통합 타임라인 조회의 partition key.
  userId        String
  user          User     @relation("OfflineEntrySubject", fields: [userId], references: [id], onDelete: Cascade)
  /// 입력 teacher/admin User.id — withActor 가 audit actor 와 동일 캡처.
  authorId      String
  author        User     @relation("OfflineEntryAuthor", fields: [authorId], references: [id])
  /// 활동 유형 — 'practice' (연습) | 'observation' (관찰) | 'note' (메모).
  kind          String
  /// 짧은 메모 (max 500자 — Server Action Zod 검증). CON-04 금칙어 0건 보장.
  note          String
  /// 실 활동 발생 시각 (입력자가 backdate 가능, default now).
  observedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// B2B 다중 테넌트 — author 의 institution scope. RLS cross-tenant 차단 hook.
  institutionId String?

  @@index([userId, observedAt])
  @@index([authorId])
}

// ============================================================================
// DB-011 후속 — AuditLog (Prisma 모델 정의, raw SQL migration 으로 이미 DB 존재)
//
// 배경:
//   - `prisma/migrations/20260512123555_enable_rls_policies/migration.sql` 가
//     `AuditLog` 테이블 + `audit_select_admin` RLS 정책을 raw SQL 로 생성.
//   - `prisma/migrations/20260522210000_audit_log_triggers/migration.sql` 가
//     PostgreSQL TRIGGER (`audit_trigger_fn` + `audit_sanitize_jsonb`) 등록.
//   - 본 모델 정의는 **신규 migration 없이** schema 만 동기 — `npx prisma generate`
//     실행 시 typed client (`prisma.auditLog`) 가 활성화되어 `/admin/audit`
//     페이지가 type-safe 하게 조회 가능.
//   - `npx prisma migrate dev` 는 호출 금지 (DB 와 schema 가 이미 정합).
//
// 컬럼 매핑 (raw SQL 대비):
//   id          UUID PK              → @id @db.Uuid (default DB-side gen_random_uuid)
//   actorId     TEXT NOT NULL        → String
//   action      TEXT NOT NULL        → String
//   tableName   TEXT NOT NULL        → String
//   rowId       TEXT NULLABLE        → String?
//   diff        JSONB NULLABLE       → Json?
//   createdAt   TIMESTAMPTZ NOT NULL → DateTime @default(now())
//
// 인덱스:
//   - raw SQL: `AuditLog_actorId_createdAt_idx` ON ("actorId", "createdAt" DESC)
//   - 본 schema: actorId / createdAt 단일 조합 인덱스 (Prisma 가 동일 인덱스명으로 mapping).
//   - tableName + rowId 조회 가속용 인덱스도 함께 정의 (admin 페이지 cursor 페이지네이션).
//
// R4 (자녀 식별 정보 보호):
//   - diff JSONB 는 TRIGGER 측 `audit_sanitize_jsonb` 으로 자동 [REDACTED] 처리됨.
//   - lib/audit.ts 측 INSERT 는 호출자 책임 — 본 모델은 raw 데이터 그대로 READ.
//   - admin 페이지가 sanitized 값을 그대로 표시해도 자녀 PII 노출 0건.
//
// RLS:
//   - `audit_select_admin` 정책이 admin role 만 SELECT 허용.
//   - Prisma는 service_role 키 (RLS 우회) 또는 admin auth session 으로 조회.
//   - 본 PR 의 admin 페이지는 page-level RBAC + Prisma 의 service_role 분기에 의존.
// ============================================================================

model AuditLog {
  /// UUID PK — DB side `gen_random_uuid()` default (raw SQL migration 에 정의).
  id        String   @id @default(uuid()) @db.Uuid
  /// 인증 user.id 또는 'anonymous' / 'system' (TRIGGER fallback).
  actorId   String
  /// 동작 라벨 — lib/audit.ts 의 AuditAction 또는 TRIGGER 의 `{Table}_{op}` 패턴.
  action    String
  /// 감사 대상 테이블명 (예: "ConsentSignature", "User", "HITLQueue").
  tableName String
  /// 감사 대상 row id. INSERT pre-validation 실패 등은 null.
  rowId     String?
  /// 변경 diff JSONB. TRIGGER 가 자동 sanitize → 자녀 PII 자동 [REDACTED].
  diff      Json?
  /// 발생 시각.
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId])
  @@index([tableName, rowId])
}

// ============================================================================
// CR-2026-009 — LiteracyResult (문해력 놀이/probe 결과 영속)
// 5단계 사다리(lib/literacy/stages.ts) 기반. 발음 EvaluationResult 와 분리된 별도 테이블.
//
// ⚠️ 임상 안전 경계 (project 규칙 — 임상 보정은 display 레이어에만):
//   - rawScore 는 원점수 — **보정 금지**. referenceBand(참고밴드)는 display 레이어 전용이며
//     임상 규준 검증(Phase 2: 출시가능 밴드 0건) 통과 전까지 null(연습-only).
//   - 발음 채점(diagnosis)·HITL·escalation 과 무관 — 별도 활동.
//   - 영속은 게임 활성 플래그 ON + 인증 user + PIPA 동의 시에만(Server Action 게이트).
// R4: userId(User UUID)만 — 자녀 식별 정보 미저장. childAgeMonths(월령)만.
// CON-04: 본 model 컬럼/값에 "치료/진단/장애" 금칙어 0.
// RLS: literacy_result_select_own / literacy_result_insert_own (defense-in-depth).
// ============================================================================

model LiteracyResult {
  id             String   @id @default(uuid()) @db.Uuid
  /// 결과 주체 User.id — 부모(자녀 보호자). withActor 가 audit actor 캡처.
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 발달 단계(stages.ts LiteracyStageId): "S0".."S4" — 게임 구인 기준(registry.stage).
  stage          String
  /// 놀이 slug (registry LITERACY_GAMES 와 정합 — 구인 식별).
  gameSlug       String
  /// 원점수(raw) — 구인별(0/1 합·완료시간 ms·정확음절수 등). **보정 금지(display 레이어만).**
  rawScore       Float
  /// 분모/총문항(구인별, 선택).
  rawTotal       Float?
  /// 측정 시 자녀 월령 (만 2~12세 = 24~144).
  childAgeMonths Int
  /// 임상 참고밴드(display 전용). Phase 2 검증 통과 단계만 — 그 전까지 null(연습-only).
  referenceBand  String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([stage, gameSlug])
}

// ============================================================================
// DB-017 (V07 신규) — F11 부모 음성 클로닝 모델 메타데이터
//
// Refs: V07 §4.1 F11, REQ-FUNC-036/037, ADR-03 (7일 폐기), ADR-09 (윤리 차단).
//
// 책임:
//   - ElevenLabs TTS 클로닝 API 가 발급한 modelHash 와 사용 제약을 보관.
//   - 7일 만료 Cron 이 expiresAt < now AND deletedAt IS NULL 조회 → ElevenLabs DELETE
//     + deletedAt UPDATE.
//   - appliedContentTypes — storybook / lullaby 화이트리스트 (교정 0건 자동 검증).
//
// R4 (자녀 보호):
//   - userId 는 부모 user.id — 자녀 식별 아님.
//   - modelHash 는 ElevenLabs 내부 ID — PII 자체는 아님 (음성 자체는 ElevenLabs 측 저장).
//   - audit_log_triggers 자동 capture (User 변경은 추적, voice_models 자체는 별도 TRIGGER 미적용 — 본 PR 범위 외).
//
// F10 정합:
//   - 본 PR 은 ADR-09 윤리 차단 만 — F10 동의 Tier 필요 시 별도 PR.
// ============================================================================

model VoiceModel {
  id                   String   @id @default(uuid()) @db.Uuid
  /// 부모 user.id (FK).
  userId               String
  /// ElevenLabs API 가 발급한 voice ID (clone API response).
  modelHash            String   @unique
  /// 모델 라벨 (UI 표시용 — "엄마 목소리" 등). 자녀 식별 정보 미포함.
  label                String?
  /// 생성 시각.
  createdAt            DateTime @default(now())
  /// 만료 시각 (createdAt + 7일, ADR-03).
  expiresAt            DateTime
  /// 화이트리스트 — ADR-09 윤리 (storybook / lullaby 만 허용, exercise 금지).
  appliedContentTypes  String[] @default([])
  /// 7일 만료 Cron 이 DELETE 후 marker. 본 컬럼 not-NULL = soft deleted.
  deletedAt            DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, deletedAt])
}

// ============================================================================
// DB-018 (V07 신규) — F16 오프라인 일반화 푸시 알림 구독 (Phase 1+)
//
// Refs: V07 §4.1 Epic F16, REQ-FUNC-040 (Web Push 일 1회 18:00 + 옵트인 only),
//       ADR-10 (D5 PWA 부활 의존 — 게이트 off 기본), 정보통신망법 §50 (영리성 옵트인).
//
// 책임:
//   - Web Push API 구독 정보 (endpoint + p256dh + auth). _옵트인 source of truth = 본 row 존재_.
//   - dispatch Cron 이 본 테이블 조회 → web-push 발송. 옵트아웃 = row DELETE.
//   - notificationPreference JSON 의 f16PushEnabled 미러는 의도적 미사용 — 이메일 선호
//     update 가 normalizeNotificationPreference 로 unknown 키를 버려 round-trip clobber 발생
//     (app/actions/update-notification-preference.ts). row 존재가 단일 진실원 → clobber 무관.
//
// R4: endpoint 는 push gateway URL (PII 아님). p256dh/auth 는 구독 payload 암호화 키.
// 게이트: F16_PUSH_ENABLED + VAPID 키 (lib/push/config.ts). 기본 off — D5 부활 시 활성.
// FK: application-level (VoiceModel / ChatMessage 동일 컨벤션 — User @relation 미선언).
// ============================================================================

model PushSubscription {
  id           String    @id @default(uuid()) @db.Uuid
  /// 구독 소유 user.id.
  userId       String
  /// Web Push endpoint URL — push gateway 주소. @unique (동일 브라우저 재구독 시 upsert).
  endpoint     String    @unique
  /// 구독 공개키 (p256dh) — payload 암호화용.
  p256dh       String
  /// 구독 auth secret — payload 암호화용.
  auth         String
  /// 마지막 발송 시각 (dispatch Cron 갱신). null = 미발송.
  lastSentAt   DateTime?
  /// 알림 dismiss 누적 횟수 (Phase 2 빈도 적응 — 임계 이상 dispatch skip / 자동 옵트아웃).
  dismissCount Int       @default(0)
  /// 구독 생성 시각 (= 정보통신망법 §50 명시 옵트인 기록 시점).
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([lastSentAt])
}

// ============================================================================
// DB-NEW-F15-1 (V07 신규) — F15 LLM 발화 유도 챗봇 메시지 (Phase 1+)
//
// Refs: V07 §4.1 Epic F15, REQ-FUNC-038/039, ADR-03 (7일 폐기), ADR-04 (금칙어 0건),
//       ADR-14 (임상 안전 게이트 — KOPLAC 13항목 + 자문 4주+82만 + F15_CHAT_ENABLED).
//
// 책임:
//   - 자녀 자유 발화 유도 대화 메시지. R4: INSERT 전 pii-mask + 금칙어 검열 통과분만 저장.
//   - 7일 자동 폐기(ADR-03): expiresAt < now 를 chat-cleanup Cron 이 hard-DELETE (텍스트는 외부 의존 0).
//   - userId 는 부모 user.id (자녀 식별 아님). 단일턴(D6) — 멀티턴 pgvector 는 Phase 2.
//
// ⚠️ 활성: F15_CHAT_ENABLED flag (default false). ADR-14 §10 KOPLAC 13항목(자문 4주+82만) 통과 전 비활성.
//          13항목 #11 IRB(ADR-15 — T4-c 외부협력 시 조건부)·#12 식약처는 해당성 검토 항목이지 무조건 선행조건 아님
//          (2026-05-30 CR: 본문 우선/IRB 조건부 — docs/f15-t4c-irb-analysis §CR).
//          2026-05-30 KOPLAC 검증은 CL-01~04(진단 채점) 한정 — F15 활성 전제 아님.
//
// ※ 격리 불변식 (no-regret #3, __tests__/security/chat-isolation.test.ts 가 CI 강제):
//   본 모델에 sessionId 컬럼이나 EvaluationResult/HITLQueue/ModelRetrainingData 와의 @relation 을
//   추가하면 재학습 그래프(sessionId 키체인)와 join 가능해져 자녀 발화의 환류(→재학습/HITL) 위험 발생.
//   content 는 write(create)+7일 hard-DELETE(+계정삭제 시 deleteMany) 외 read-back 0 을 유지할 것.
//   추가 필요 시 ADR-03(7일 폐기)·R4(자녀 보호)·F15 활성 게이트 재검토 필수.
// ============================================================================

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  /// 부모 user.id (application-level FK — VoiceModel 패턴). 자녀 식별 아님.
  userId    String
  /// 메시지 역할 — 'user'(발화) | 'assistant'(챗봇 응답).
  role      String
  /// 메시지 본문. R4 sanitize(pii-mask) + 금칙어 검열 통과분만 저장. 자녀 발화는 7일 폐기로 이중 보호.
  content   String
  /// 생성 시각.
  createdAt DateTime @default(now())
  /// 만료 시각 (createdAt + 7일, ADR-03). chat-cleanup Cron 이 sweep.
  expiresAt DateTime

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// ============================================================================
// DB-016 (V07 신규) — HITL 재학습 데이터 적재 테이블
//
// Refs: V07 §5.3 (재학습 파이프라인), REQ-FUNC-HITL-005, ADR-11.
//
// 책임:
//   - 전문가가 HITLQueue.groundTruthScore 를 UPDATE 하면 PostgreSQL TRIGGER
//     `sync_retraining_data` 가 본 테이블에 자동 INSERT.
//   - 3 게이트 Daily Cron (FR-C-HITL-006) 이 diffPct + cumulative + HHI 통과 시만
//     외부 ML 엔지니어 위탁 알림 → admin 승인 후 재배포.
//
// R4 정합:
//   - aiScore / groundTruthScore JSONB 는 audit_sanitize_jsonb 강제 통과.
//   - expertComment 등 PII 위험 컬럼은 미포함 (HITLQueue 의 metadata 만 추출).
//
// F10 consent Tier 정합:
//   - consentTier T1~T4 — T1/T2/T3 는 즉시 INSERT 차단 (사용자 동의 미충족).
//   - T4-a/b/c 만 INSERT 허용 — TRIGGER 내부 분기.
//   - 현재 사용자 base 에 T4 consent tier 컬럼 부재 — 본 PR 의 sanitized 컬럼이
//     "동의 검증 통과 후 INSERT 된" 표식 (default false, TRIGGER 가 true 로 세팅).
model ModelRetrainingData {
  id                String   @id @default(uuid()) @db.Uuid
  /// EvaluationResult.sessionId 와 1:1 (TRIGGER 가 캡처).
  sessionId         String   @unique
  /// AI 의 원본 3축 점수 + peerPercentile + confidence — JSONB sanitized.
  aiScore           Json
  /// expert 의 보정 3축 점수 + peerPercentile — JSONB sanitized.
  groundTruthScore  Json
  /// 전문가 user.id (HITLQueue.assignedExpertId 또는 reviewedBy 우선).
  expertId          String
  /// |aiScore.articulation - groundTruthScore.articulation| / aiScore.articulation × 100
  /// — 3 게이트 의 첫 게이트 (≥ 0.5%) 비교 기준.
  diffPct           Float
  /// F10 동의 Tier — "T4-a" / "T4-b" / "T4-c" 만 허용. TRIGGER 가 미충족 row INSERT skip.
  consentTier       String
  /// R4 sanitize 통과 표식 — audit_sanitize_jsonb 적용 후 true.
  sanitized         Boolean  @default(false)
  /// 적재 시각.
  createdAt         DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([expertId, createdAt(sort: Desc)])
  @@index([diffPct])
}

// ============================================================================
// ADR-13 — SystemConfig (런타임 키-밸류 토글 + 멱등성 타임스탬프)
//
// Refs: ADR-13 (getCurrentPhase 하이브리드 — env override → DB → default),
//       FR-C-HITL-006 (재학습 멱등성 retraining_triggered_at), FR-C-HITL-007 (다양성 phase).
//
// 책임:
//   - HITL 재학습/다양성 Cron 의 _멱등성 가드_ (마지막 트리거 시각 — 7일 내 재발화 차단).
//   - 운영 phase 토글 (phase1/phase2) — env 미설정 시 DB 값, 둘 다 없으면 phase1 default.
//   - 향후 F15/F16 게이트 등 런타임 토글 공용 store (key 네임스페이스로 확장).
//
// 정책: 값은 _문자열_ (타임스탬프=ISO, phase='phase1'/'phase2', boolean='true'/'false').
//   lib/config/system-config.ts 가 유일 진입점 (타입 안전 + graceful 폴백).
// R4: 운영 설정만 — 사용자/자녀 식별 정보 미저장.
// ============================================================================

model SystemConfig {
  /// 설정 키 (예: 'hitl_retraining_triggered_at' / 'hitl_diversity_alerted_at' / 'hitl_diversity_phase').
  key       String   @id
  /// 값 (문자열 — ISO 타임스탬프 / 'phase1'|'phase2' / 'true'|'false').
  value     String
  /// 마지막 갱신 시각.
  updatedAt DateTime @updatedAt @default(now())
}

// ============================================================================
// INFRA-005 후속 — 서버 측 분석 이벤트 query-able sink (Phase 1)
//
// Refs: MON-001(funnel.ts 가 '옵션 B'로 보류했던 store), AGENTS.md §2.2(PII), R4.
//
// 배경:
//   - client trackEvent(lib/analytics.ts)는 @vercel/analytics 로 전송(작동). funnel KPI 는 도메인
//     테이블 역산(lib/analytics/funnel.ts)으로 측정(작동). 그러나 **서버 측 trackEvent 는 Vercel
//     Analytics(브라우저 SDK) 호출 불가 → prod no-op 으로 유실**. 본 테이블이 그 갭을 채운다.
//   - trackServerEvent(lib/analytics-server.ts)가 fire-and-forget + graceful 로 INSERT.
//
// PII/R4: properties 에 자녀 식별 정보(email/name/raw transcript) 절대 금지(호출 측 책임 + 카탈로그
//   shape 강제). userId 는 부모 user.id(선택) — 내부 분석 join 용. 본 테이블은 service-role 전용
//   (RLS 기본 deny — 클라이언트 직접 접근 0; deploy 시 RLS 정책 적용).
// ============================================================================

model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  /// 이벤트명 (lib/events.ts 카탈로그, snake_case).
  name       String
  /// 이벤트 properties (카탈로그 shape — 자녀 식별 정보 0건).
  properties Json?
  /// 부모 user.id (선택, 자녀 식별 아님). 내부 분석 join 용.
  userId     String?
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
}
