// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// DB-002 — User (모든 사용자 관련 FK 의 부모)
// Refs: SRS §2 Stakeholders, §6.1 ERD users, REQ-NF-019 RBAC.
// 개인정보 최소화 원칙 (R4): 자녀 식별정보 미저장, 월령만.
// ============================================================================

enum Role {
  parent
  teacher
  principal
  expert
  admin
}

enum SubscriptionTier {
  free
  basic
  premium
}

model User {
  /// UUID — Supabase Auth user.id 와 동일 키 (API-010).
  id               String           @id @default(uuid())
  /// 인증용 이메일 (Supabase Auth 일치). 무로그인 진단 사용자는 null.
  email            String?          @unique
  /// RBAC 역할. REQ-NF-019 의 키.
  role             Role
  /// 부모의 자녀 월령 (만 2~7세 = 24~84). 부모 외 역할은 null.
  childAgeMonths   Int?
  /// FR-C-PARENT-SETTINGS — 부모가 /settings/child 에서 선택한 관심 음소 목록.
  /// 화이트리스트: ALLOWED_PHONEMES (ㄱ/ㄴ/ㅅ/ㅈ/ㄹ), 0~5개 (빈 배열 허용 = 시스템 자동 선택).
  /// R4: 자녀 식별 정보 0건 — 단순 음소 라벨만. 부모 외 역할은 빈 배열로 운용.
  preferredPhonemes String[]         @default([])
  /// FR-C-PARENT-ONBOARDING (follow-up) — 신규 부모 first-time wizard 완료 시각.
  /// localStorage 마킹과 동기화되는 canonical 서버 상태 — 다중 디바이스에서도
  /// 동일한 wizard 노출 여부 결정에 사용. null = 미완료 / 미실행.
  onboardingCompletedAt DateTime?
  /// FR-C-NOTIFICATION-PREFERENCE — 알림 종류별 opt-in/out 선호.
  /// shape (런타임 Zod 검증, lib/notifications/preference.ts NotificationPreference):
  ///   { weeklyReportEmail, cushionNoteEmail, consentReminderEmail, parentInviteEmail }
  /// default '{}' = 모든 키 누락 = opt-out 기반 (helper 가 DEFAULTS 로 merge — default true).
  /// 트랜잭션성 알림 (계정 변경 / 비밀번호 reset 등) 은 본 컬럼 무관 — 항상 발송.
  notificationPreference Json?     @default("{}")
  /// FR-C-SECURITY (MFA 마무리) — TOTP 활성 시 발급된 backup codes 의 sha256 hash 리스트.
  /// 정책 (lib/security/backup-codes-store.ts):
  ///   - 1회 사용 후 array 에서 제거 (재사용 불가 — DB 레벨로 멱등 보장).
  ///   - 사용자 표시는 enroll verify 직후 평문 1회만 — 그 후 hash 만 DB 보존.
  ///   - "재생성" 시 기존 hash 전부 무효화 + 새 8개 생성.
  /// R4: hash 만 저장 (원본 평문 불가역) — 데이터 유출 시에도 backup code 자체 비공개.
  totpBackupCodes String[] @default([])
  /// SEC-COMP-PIPA — PIPA §22-6 만 14세 미만 부모 대리 동의 일시 (Grill #3A A1).
  /// null = 미동의. 본 컬럼이 null 인 parent 는 자녀 진단 / 발화 데이터 처리 차단.
  /// 본 동의는 자녀의 개인정보 처리 (음성 transcript, 월령, 발달 점수) 의 법정대리인 동의 근거.
  /// /settings/privacy-consent 페이지에서 사용자가 직접 체크 → 일시 기록.
  pipaUnderageConsentAt DateTime?
  /// SEC-COMP-PIPA — PIPA §17 개인정보 국외 이전 동의 일시 (Grill #3A A2).
  /// null = 미동의. 본 컬럼이 null 이면 STT (Google Cloud Speech US) / Gemini API (US/global) 호출 차단.
  /// 대상: Google Cloud Speech (Web Speech API 경유) + Google AI Studio (Gemini) 의 미국 / 글로벌 위치.
  overseasTransferConsentAt DateTime?
  /// 구독 등급. 기본 free.
  subscriptionTier SubscriptionTier @default(free)
  /// 가입 시각.
  createdAt        DateTime         @default(now())

  // --- DB-003 추가 컬럼 (B2B) ---
  /// parent 는 nullable, teacher/principal 은 비즈니스 로직 레벨로 필수.
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  /// parent: 자녀가 속한 반 / teacher: 담당 반.
  classId       String?
  class         Class?       @relation(fields: [classId], references: [id])

  // --- 역방향 관계 (FK 자체는 자식 쪽 모델에서 정의) ---
  sessionLogs       SessionLog[]
  evaluationResults EvaluationResult[]
  weeklyReports     WeeklyReport[]
  rewardProgress    RewardProgress?
  /// DB-008b: 보상 발급 이력 (멱등성 + 감사).
  rewardLogs        RewardLog[]
  /// DB-009: 본인이 검토 대상이 된 HITL 큐 (parent role 일반적).
  hitlQueues        HITLQueue[]        @relation("HITLSubject")
  /// DB-009: expert 로 지정되어 검토 담당하는 HITL 큐.
  assignedHITLs     HITLQueue[]        @relation("AssignedExpert")
  /// FR-Q-013 후속 — 본인이 대상인 (자녀) 오프라인 활동 기록.
  offlineEntriesAsSubject OfflineEntry[] @relation("OfflineEntrySubject")
  /// FR-Q-013 후속 — 본인이 입력한 (teacher) 오프라인 활동 기록.
  offlineEntriesAsAuthor  OfflineEntry[] @relation("OfflineEntryAuthor")

  @@index([institutionId])
  @@index([classId])
}

// ============================================================================
// DB-003 — Institution / Class (B2B 다중 테넌트)
// Refs: §6.1 ERD institutions, REQ-FUNC-046/047, REQ-NF-019.
// ============================================================================

model Institution {
  id                    String    @id @default(uuid())
  name                  String
  principalName         String
  principalEmail        String?   @unique
  phone                 String?
  address               String?
  /// F10 동의서 완료 여부.
  consentStatus         Boolean   @default(false)
  /// Supabase Storage path (DB-002 추가 후 Storage 연동 시 사용).
  logoUri               String?
  subscriptionStartedAt DateTime?
  /// "trial" | "annual_500k" | "annual_1m" — 진입 SKU.
  subscriptionTier      String    @default("trial")
  createdAt             DateTime  @default(now())

  // 역방향
  classes Class[]
  users   User[]
}

model Class {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  /// 담임 교사 (User.role = teacher).
  teacherId     String?
  createdAt     DateTime    @default(now())

  users User[]

  @@index([institutionId])
}

// ============================================================================
// DB-004 — SessionLog (발화 세션 메타데이터)
// Refs: §6.1 ERD session_logs, REQ-FUNC-005, C-TEC-003.
// D6 단순화: audioVectorUri 는 컬럼만 확보 (Sprint 1엔 항상 null), pgvector
// 활성화는 P2 별도 마이그레이션.
// ============================================================================

model SessionLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 진단 세션은 null. 미션 세션이면 MissionCard.id.
  missionId     String?
  mission       MissionCard? @relation(fields: [missionId], references: [id])
  startTime     DateTime @default(now())
  durationSec   Int
  /// TODO: P2 pgvector 활성화 시 vector(768) 타입으로 마이그레이션.
  audioVectorUri String?
  createdAt     DateTime @default(now())

  evaluationResult EvaluationResult?

  @@index([userId, startTime])
}

// ============================================================================
// DB-005 — EvaluationResult (3축 점수 + 백분위 + Confidence)
// Refs: §6.1 ERD evaluation_results, REQ-FUNC-001~003 / 012~013.
// 횡단 CON-04: aiCushionText 는 금칙어 0건 (Server Action 진입 시 검증, FR-C-005).
// ============================================================================

model EvaluationResult {
  id                 String   @id @default(uuid())
  /// SessionLog 1:1.
  sessionId          String   @unique
  sessionLog         SessionLog @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 3축 점수 (0~100 비즈니스 규칙, Zod 검증 책임).
  articulationScore  Float
  linguisticScore    Float
  acousticScore      Float
  /// 또래 백분위 (0~100).
  peerPercentile     Float
  /// 0~100, < 70 시 HITL 이관 (FR-C-002).
  confidence         Float
  /// 전문가 검토 완료 여부.
  hitlReviewed       Boolean  @default(false)
  /// 금칙어 0건 보장 (CON-04). 부모용 쿠션 텍스트.
  aiCushionText      String?
  targetPhoneme      String
  childAgeMonths     Int
  /// Sprint 3 §2 B — Web Audio API 추출 음향 특징 (pitchMean / pitchStd / durationSec / energy).
  /// 미지원 환경 (jsdom, 권한 거부) 또는 미측정 시 null. 스키마는 lib/audio/analyzer.ts AcousticFeatures.
  acousticFeatures   Json?
  createdAt          DateTime @default(now())

  /// DB-009 역방향: Confidence < 70 시 1:1 매핑된 HITL 큐.
  hitlQueue          HITLQueue?

  @@index([userId, createdAt])
}

// ============================================================================
// DB-006 — MissionCard (음소·난이도별 카탈로그)
// Refs: §6.1 ERD mission_cards, REQ-FUNC-015, 021~022.
// ============================================================================

model MissionCard {
  id              String   @id @default(uuid())
  /// 한국어 음소 (예: "ㅅ").
  targetPhoneme   String
  /// 1~5.
  difficultyLevel Int
  /// "star" | "tree" | "drawing".
  rewardType      String
  title           String
  /// 지시문. 금칙어("진단", "장애" 등) 금지.
  instructionText String
  mediaUri        String?
  /// 월령 (만 2~7세 = 24~84).
  ageRangeMin     Int
  ageRangeMax     Int
  createdAt       DateTime @default(now())

  sessionLogs SessionLog[]

  @@index([targetPhoneme, difficultyLevel])
}

// ============================================================================
// DB-007 — WeeklyReport (주간 추이 + 예측)
// Refs: §6.1 ERD weekly_reports, REQ-FUNC-027/028/044, REQ-NF-004.
// scoreTrend Json 스키마: lib/weekly-report.ts 의 ScoreTrend 타입 + Zod.
// ============================================================================

model WeeklyReport {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ISO 8601 주차 (1~53).
  weekNumber           Int
  year                 Int
  /// ScoreTrend[] JSON 배열 (date / phoneme / 3축 / peerPercentile).
  scoreTrend           Json
  /// 회귀 모델 예측 점수.
  predictedNextScore   Float?
  /// 신뢰구간.
  predictionConfidence Float?
  articulationAvg      Float
  linguisticAvg        Float
  acousticAvg          Float
  peerPercentileAvg    Float
  sessionCount         Int
  generatedAt          DateTime @default(now())
  /// FR-WEEKLY-UNREAD — 부모가 /weekly-review 페이지를 열어 본 시각.
  /// null = 미열람 (parent nav badge "📅 우리 아이 주간 리뷰" 옆 dot 노출 조건).
  /// 한 번 set 되면 cron 으로 새 row 가 생기기 전까지 유지.
  viewedAt             DateTime?

  @@unique([userId, year, weekNumber])
  @@index([userId, generatedAt])
}

// ============================================================================
// DB-008 — RewardProgress (별·나무·AI그림 누적, userId 1:1)
// Refs: §6.1 ERD reward_progress, REQ-FUNC-024~026, REQ-NF-005.
// ============================================================================

model RewardProgress {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cumulativeStars  Int      @default(0)
  treeGrowthLevel  Int      @default(0)
  aiDrawingCount   Int      @default(0)
  updatedAt        DateTime @updatedAt
}

// ============================================================================
// DB-008b (Sprint 2) — RewardLog (멱등성 보장 + 감사 로그)
// Sprint 1 의 process-local Set 멱등성을 다중 인스턴스 안전한 DB unique 제약으로 교체.
// @@unique([userId, idempotencyKey]) 가 중복 INSERT 를 SQL 레벨에서 차단.
// 향후 reward 발급 이력 조회 / 통계 / 분쟁 처리에도 활용.
// ============================================================================

model RewardLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "star" | "tree" | "drawing".
  rewardType      String
  amount          Int
  /// FR-C-009 멱등성 키 (예: `${sessionId}-star-1`).
  idempotencyKey  String
  createdAt       DateTime @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

// ============================================================================
// DB-009 — HITLQueue (Confidence < 70 자동 이관 대기열)
// Refs: §3.5 hitl/queue, REQ-FUNC-003/032/HITL-001~003, §3.6.2.
// D4 단순화: Supabase Realtime 미사용. 알림은 Slack 웹훅, 운영은 Supabase Studio.
// 횡단 R4: expertComment / groundTruthScore 는 자녀 식별 불가능한 형식 강제.
// ============================================================================

enum HITLStatus {
  pending
  in_review
  completed
  escalated
  dismissed
}

// ============================================================================
// DB-010 — ConsentSignature (FR-C-018 #41) — 동의서 발송 + D+3 리마인더 + 7일 만료
// Refs: SRS §3.5, REQ-FUNC-059~061, REQ-NF-019 (감사 로그).
// 법적 효력: IP / UserAgent / consentText 스냅샷 / 타임스탬프 보존 (서명 후).
// R4 (자녀 보호): 자녀 식별 정보는 별명 (childNickname) 만 보관. 본명/생년월일/주소/연락처 미저장.
// CON-04: 본 model 의 어떤 컬럼도 "치료/진단/장애" 금칙어 미포함 — Server Action 진입 시 검증.
// ============================================================================
//
// 라이프사이클:
//   pending → signed   (부모 서명 완료, signedAt 기록)
//   pending → expired  (sentAt + 7d 경과, expired cron 이 마킹)
//
// D+3 리마인더:
//   pending && sentAt < now - 3d && remindedAt IS NULL → reminder cron 이 발송 후 remindedAt 기록.
//   이미 remindedAt 있는 row 는 skip (멱등).
//
// token:
//   UUID v4 default. parent 가 서명 페이지 진입 시 URL 의 token 으로 단건 조회.
//   token 노출은 본인 only (이메일 inbox) — R4 정책.
//
// 인덱스:
//   - (status, sentAt) — cron 의 D+3 / 7d 스캔 효율.
//   - (parentEmail) — 동일 부모/자녀 중복 발급 시 멱등 조회.
//   - (token) — UNIQUE — 서명 페이지 단건 조회.

model ConsentSignature {
  id            String    @id @default(uuid())
  parentEmail   String
  parentName    String
  childNickname String
  consentType   String    @default("data_usage")
  /// 'pending' | 'signed' | 'expired'.
  status        String    @default("pending")
  token         String    @unique
  sentAt        DateTime  @default(now())
  remindedAt    DateTime?
  signedAt      DateTime?
  expiredAt     DateTime?
  /// 서명 완료 시 저장되는 IP (법적 효력 — 익명 부모도 IP 단서로 분쟁 대응).
  signedIp      String?
  /// 서명 완료 시 저장되는 UserAgent.
  signedUa      String?
  /// 기관 컨텍스트 (B2B). 일반 parent 직접 발급 시 null.
  institutionId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, sentAt])
  @@index([parentEmail])
  @@index([token])
}

model HITLQueue {
  id               String     @id @default(uuid())
  /// EvaluationResult.sessionId 와 1:1.
  sessionId        String     @unique
  evaluationResult EvaluationResult @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  /// 검토 대상 사용자 (parent 일반적).
  userId           String
  user             User       @relation("HITLSubject", fields: [userId], references: [id], onDelete: Cascade)
  confidenceScore  Float
  status           HITLStatus @default(pending)
  /// Supabase Studio 수동 할당 (expert role).
  assignedExpertId String?
  assignedExpert   User?      @relation("AssignedExpert", fields: [assignedExpertId], references: [id])
  expertComment    String?
  /// 보정 3축 점수 {articulation, linguistic, acoustic, peerPercentile}.
  groundTruthScore Json?
  /// FR-C-013 (#36) — 전문가 보정 단일 종합 점수 (0~100, 선택). groundTruthScore (3축) 와 보완 관계.
  correctedScore   Int?
  /// FR-C-013 (#36) — 검토(코멘트 PATCH) 완료 시각. completedAt 과 별도: completedAt 은 큐 라이프사이클 종료 시점.
  reviewedAt       DateTime?
  /// FR-C-013 (#36) — 검토 actor (Supabase auth uid). assignedExpertId 와 다를 수 있음 (admin 대리 검토).
  reviewedBy       String?
  /// 등록 시각 + 48h (REQ-NF-012).
  slaDueAt         DateTime
  /// 24h 초과 시 Cron 이 자동 마킹 (FR-C-014).
  escalatedAt      DateTime?
  /// FR-C-014 잔여 (#37) — 수동/자동 escalation 주체 User.id (자동 cron 시 null).
  escalatedBy      String?
  /// FR-C-014 잔여 (#37) — 'expert_judgment' | 'sla_at_risk' | 'duplicate' | 'manual' | 'auto_cron_24h'.
  escalationReason String?
  completedAt      DateTime?
  createdAt        DateTime   @default(now())

  @@index([status, slaDueAt])
}

// ============================================================================
// FR-Q-013 후속 — OfflineEntry (선생님이 수기 기록하는 자녀 오프라인 활동)
// Refs: §6.1 ERD (확장), REQ-FUNC-058 (B2B 오프라인 활동 통합), REQ-NF-019.
//
// 책임:
//   - 센터/유치원의 선생님이 자녀의 오프라인 발음 연습/관찰/메모를 수기 기록.
//   - 통합 타임라인 (lib/timeline/aggregator.ts loadUserTimeline) 의
//     "offline" kind entry source — 앱 세션(diagnose/mission) 과 merge 노출.
//
// R4 (자녀 보호):
//   - note 본문은 짧은 메모 (max 500자) — 자녀 본명/주소/생년월일/연락처 입력 시
//     입력자(teacher) 책임. 본 PR 은 자동 PII 검출 X — README/UI 안내로 처리.
//   - userId/authorId 는 User UUID 만, 자녀 식별 정보 미저장.
//
// CON-04 (의료 금칙어):
//   - kind 는 'practice' | 'observation' | 'note' enum-like — "치료/진단/장애" 미포함.
//   - note 본문은 Server Action 진입 시 hasBannedTerm 검증 (reject).
//
// 라이프사이클:
//   - INSERT: Server Action /app/actions/offline-entry.ts (teacher/principal/admin)
//   - SELECT: 부모(본인 userId) + teacher/principal/admin/expert (RLS)
//   - UPDATE: author 본인 or admin (수정 기록은 audit_trigger_fn 캡처)
//   - DELETE: admin only
// ============================================================================

model OfflineEntry {
  id            String   @id @default(uuid()) @db.Uuid
  /// 자녀(보호자) User.id — 통합 타임라인 조회의 partition key.
  userId        String
  user          User     @relation("OfflineEntrySubject", fields: [userId], references: [id], onDelete: Cascade)
  /// 입력 teacher/admin User.id — withActor 가 audit actor 와 동일 캡처.
  authorId      String
  author        User     @relation("OfflineEntryAuthor", fields: [authorId], references: [id])
  /// 활동 유형 — 'practice' (연습) | 'observation' (관찰) | 'note' (메모).
  kind          String
  /// 짧은 메모 (max 500자 — Server Action Zod 검증). CON-04 금칙어 0건 보장.
  note          String
  /// 실 활동 발생 시각 (입력자가 backdate 가능, default now).
  observedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// B2B 다중 테넌트 — author 의 institution scope. RLS cross-tenant 차단 hook.
  institutionId String?

  @@index([userId, observedAt])
  @@index([authorId])
}

// ============================================================================
// DB-011 후속 — AuditLog (Prisma 모델 정의, raw SQL migration 으로 이미 DB 존재)
//
// 배경:
//   - `prisma/migrations/20260512123555_enable_rls_policies/migration.sql` 가
//     `AuditLog` 테이블 + `audit_select_admin` RLS 정책을 raw SQL 로 생성.
//   - `prisma/migrations/20260522210000_audit_log_triggers/migration.sql` 가
//     PostgreSQL TRIGGER (`audit_trigger_fn` + `audit_sanitize_jsonb`) 등록.
//   - 본 모델 정의는 **신규 migration 없이** schema 만 동기 — `npx prisma generate`
//     실행 시 typed client (`prisma.auditLog`) 가 활성화되어 `/admin/audit`
//     페이지가 type-safe 하게 조회 가능.
//   - `npx prisma migrate dev` 는 호출 금지 (DB 와 schema 가 이미 정합).
//
// 컬럼 매핑 (raw SQL 대비):
//   id          UUID PK              → @id @db.Uuid (default DB-side gen_random_uuid)
//   actorId     TEXT NOT NULL        → String
//   action      TEXT NOT NULL        → String
//   tableName   TEXT NOT NULL        → String
//   rowId       TEXT NULLABLE        → String?
//   diff        JSONB NULLABLE       → Json?
//   createdAt   TIMESTAMPTZ NOT NULL → DateTime @default(now())
//
// 인덱스:
//   - raw SQL: `AuditLog_actorId_createdAt_idx` ON ("actorId", "createdAt" DESC)
//   - 본 schema: actorId / createdAt 단일 조합 인덱스 (Prisma 가 동일 인덱스명으로 mapping).
//   - tableName + rowId 조회 가속용 인덱스도 함께 정의 (admin 페이지 cursor 페이지네이션).
//
// R4 (자녀 식별 정보 보호):
//   - diff JSONB 는 TRIGGER 측 `audit_sanitize_jsonb` 으로 자동 [REDACTED] 처리됨.
//   - lib/audit.ts 측 INSERT 는 호출자 책임 — 본 모델은 raw 데이터 그대로 READ.
//   - admin 페이지가 sanitized 값을 그대로 표시해도 자녀 PII 노출 0건.
//
// RLS:
//   - `audit_select_admin` 정책이 admin role 만 SELECT 허용.
//   - Prisma는 service_role 키 (RLS 우회) 또는 admin auth session 으로 조회.
//   - 본 PR 의 admin 페이지는 page-level RBAC + Prisma 의 service_role 분기에 의존.
// ============================================================================

model AuditLog {
  /// UUID PK — DB side `gen_random_uuid()` default (raw SQL migration 에 정의).
  id        String   @id @default(uuid()) @db.Uuid
  /// 인증 user.id 또는 'anonymous' / 'system' (TRIGGER fallback).
  actorId   String
  /// 동작 라벨 — lib/audit.ts 의 AuditAction 또는 TRIGGER 의 `{Table}_{op}` 패턴.
  action    String
  /// 감사 대상 테이블명 (예: "ConsentSignature", "User", "HITLQueue").
  tableName String
  /// 감사 대상 row id. INSERT pre-validation 실패 등은 null.
  rowId     String?
  /// 변경 diff JSONB. TRIGGER 가 자동 sanitize → 자녀 PII 자동 [REDACTED].
  diff      Json?
  /// 발생 시각.
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId])
  @@index([tableName, rowId])
}
